# UI Language: russian, english, german, french, spanish, chinese, japanese, korean, ukrainian, polish
UI_LANGUAGE=russian

# Path to folder with .wav files for censoring (optional — can be selected via GUI Browse button)
AUDIO_FOLDER_PATH=c:\path\to\audio\folder

# Path to local GigaAM model folder (or leave as HF repo name "ai-sage/GigaAM-Multilingual" for online mode)
GIGAAM_MODEL_PATH=ai-sage/GigaAM-Multilingual

# Paths to local Whisper models folders (CTranslate2 format, or leave empty for online mode)
WHISPER_TINY_PATH=
WHISPER_BASE_PATH=
WHISPER_SMALL_PATH=
WHISPER_MEDIUM_PATH=
WHISPER_LARGE_V3_PATH=

# Path to local Parakeet model folder (must contain .nemo file, or leave as HF repo name for online mode)
PARAKEET_MODEL_PATH=nvidia/parakeet-tdt-0.6b-v3
